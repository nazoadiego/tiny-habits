{
	"name": "tiny-habits",
	"version": "1.2.0",
	"description": "Habit tracker plugin for obsidian (https://github.com/nazoadiego/tiny-habits)",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"dev:web": "vite --config dev/vite.config.ts",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version:new": "node scripts/new-version.mjs",
		"release": "node scripts/release.mjs",
		"test:release": "vitest run scripts --coverage.enabled=false",
		"svelte-check": "svelte-check --tsconfig tsconfig.json",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepare": "git config core.hooksPath .githooks"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"@vitest/coverage-v8": "4.0.16",
		"@vitest/ui": "^4.1.12",
		"builtin-modules": "5.5.0",
		"esbuild": "0.28.1",
		"esbuild-svelte": "^0.9.5",
		"eslint": "^9.39.5",
		"eslint-plugin-jsdoc": "^65.4.3",
		"eslint-plugin-svelte": "^3.23.1",
		"eslint-plugin-unicorn": "^63.0.0",
		"fishery": "^2.4.0",
		"globals": "^17.14.0",
		"obsidian": "latest",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-preprocess": "^6.0.5",
		"tslib": "2.9.1",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^7.3.7",
		"vitest": "^4.1.12"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"svelte-preprocess"
		]
	},
	"dependencies": {
		"dayjs": "^1.11.23",
		"tinykeys": "4.0.1"
	}
}
